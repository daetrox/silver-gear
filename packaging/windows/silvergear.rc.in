// Recursos del ejecutable de Windows: icono, manifiesto e información de versión.
#include <winver.h>

1 ICON "@ICON@"
1 24 "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @V_MAJOR@,@V_MINOR@,@V_PATCH@,0
PRODUCTVERSION @V_MAJOR@,@V_MINOR@,@V_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "0c0a04b0"
    BEGIN
      VALUE "CompanyName", "daetrox"
      VALUE "FileDescription", "Silver Gear - lanzador de Metal Gear Solid"
      VALUE "FileVersion", "@V_MAJOR@.@V_MINOR@.@V_PATCH@"
      VALUE "InternalName", "SilverGear"
      VALUE "LegalCopyright", "GPL-3.0"
      VALUE "OriginalFilename", "SilverGear.exe"
      VALUE "ProductName", "Silver Gear"
      VALUE "ProductVersion", "@V_MAJOR@.@V_MINOR@.@V_PATCH@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0c0a, 1200
  END
END
